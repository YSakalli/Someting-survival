[sub_resource type="GDScript" id="GDScript_3qydi"]
resource_name = "Player"
script/source = "extends CharacterBody2D

# Hareket
@export var speed: float = 200.0

# Can
@export var max_hp: float = 200.0
var current_hp: float = 10.0

# Silah
@export var bullet_scene: PackedScene
@export var air_bullet_scene: PackedScene
@export var water_bullet_scene: PackedScene
@export var wood_bullet_scene: PackedScene
@export var bullet_speed: float = 250.0
@export var bullet_damage: float = 5.0
@export var fire_rate: float = 0.8

var shoot_timer: float = 0.0
var double_shot: bool = false

# Air
var air_unlocked = false
var air_bounce_count = 1

# Water
var water_unlocked = false
var water_interval = 1
var water_timer = 0.0

# Wood
var wood_unlocked = false
var wood_bounce_count = 1

@onready var anim = $AnimationPlayer
@onready var camera = $Camera2D

# Kamera efektleri
var shake_amount: float = 0.0
var shake_decay: float = 25.0
var sway_amount: float = 0.0
var sway_decay: float = 6.0
var sway_time: float = 0.0
var sway_speed: float = 14.0

func _ready():
	add_to_group(\"player\")
	current_hp = max_hp
	queue_redraw()

func _draw():
	var bar_width = 22.0
	var bar_height = 3.0
	var bar_y = -18.0
	var x = -bar_width * 0.5
	draw_rect(Rect2(x - 1, bar_y - 1, bar_width + 2, bar_height + 2), Color(0, 0, 0, 0.8), true)
	var pct = 0.0
	if max_hp > 0:
		pct = clamp(current_hp / max_hp, 0.0, 1.0)
	var fill_color = Color(0.3, 0.85, 0.3, 1.0)
	if pct <= 0.25:
		fill_color = Color(0.9, 0.2, 0.2, 1.0)
	elif pct <= 0.5:
		fill_color = Color(0.95, 0.75, 0.2, 1.0)
	draw_rect(Rect2(x, bar_y, bar_width * pct, bar_height), fill_color, true)

func _physics_process(_delta):
	_handle_movement()
	_handle_shooting(_delta)
	_handle_water(_delta)
	_update_camera_effects(_delta)

func _handle_movement():
	var input = Vector2(
		Input.get_action_strength(\"ui_right\") - Input.get_action_strength(\"ui_left\"),
		Input.get_action_strength(\"ui_down\") - Input.get_action_strength(\"ui_up\")
	)
	# WASD desteği
	if Input.is_key_pressed(KEY_D):
		input.x += 1.0
	if Input.is_key_pressed(KEY_A):
		input.x -= 1.0
	if Input.is_key_pressed(KEY_S):
		input.y += 1.0
	if Input.is_key_pressed(KEY_W):
		input.y -= 1.0
	input.x = clamp(input.x, -1.0, 1.0)
	input.y = clamp(input.y, -1.0, 1.0)
	if input == Vector2.ZERO:
		velocity = Vector2.ZERO
		anim.play(\"idle\")
		return
	velocity = input.normalized() * speed
	move_and_slide()
	_play_animation(input)

func _update_camera_effects(delta):
	if camera == null:
		return
	var offset = Vector2.ZERO
	if shake_amount > 0.0:
		shake_amount = max(0.0, shake_amount - shake_decay * delta)
		offset += Vector2(randf_range(-shake_amount, shake_amount), randf_range(-shake_amount, shake_amount))
	if sway_amount > 0.0:
		sway_amount = max(0.0, sway_amount - sway_decay * delta)
		sway_time += delta
		offset.x += sin(sway_time * sway_speed) * sway_amount
		offset.y += cos(sway_time * sway_speed * 0.5) * sway_amount * 0.3
	camera.offset = offset

func shake_screen(amount: float):
	shake_amount = max(shake_amount, amount)

func sway_screen(amount: float):
	sway_amount = max(sway_amount, amount)
	sway_time = 0.0

func _handle_shooting(delta):
	shoot_timer -= delta
	if shoot_timer > 0:
		return
	var target = _get_nearest_enemy()
	if target == null:
		return
	shoot_timer = fire_rate
	_shoot(target)

func _handle_water(delta):
	if not water_unlocked:
		return
	water_timer -= delta
	if water_timer <= 0:
		water_timer = water_interval
		_shoot_water()

func _get_nearest_enemy() -> Node2D:
	var enemies = get_tree().get_nodes_in_group(\"enemies\")
	var nearest = null
	var min_dist = INF
	for e in enemies:
		var d = global_position.distance_to(e.global_position)
		if d < min_dist:
			min_dist = d
			nearest = e
	return nearest

func _shoot(target: Node2D):
	if bullet_scene == null:
		return
	_fire_bullet(target)
	if air_unlocked and air_bullet_scene:
		_fire_air_bullet(target)
	if wood_unlocked and wood_bullet_scene:
		_fire_wood_bullet(target)
	if double_shot:
		var enemies = get_tree().get_nodes_in_group(\"enemies\")
		if enemies.size() > 1:
			_fire_bullet(enemies[1])

func _fire_bullet(target: Node2D):
	var bullet = bullet_scene.instantiate()
	get_parent().add_child(bullet)
	bullet.global_position = global_position
	var direction = (target.global_position - global_position).normalized()
	bullet.move_velocity = direction * bullet_speed
	bullet.damage = bullet_damage
	bullet.rotation = direction.angle()

func _fire_air_bullet(target: Node2D):
	var bullet = air_bullet_scene.instantiate()
	get_parent().add_child(bullet)
	bullet.global_position = global_position
	bullet.speed = bullet_speed - 150
	bullet.damage = bullet_damage * 0.8
	bullet.hits_remaining = 2
	bullet.bounce_count = air_bounce_count
	var direction = (target.global_position - global_position).normalized()
	bullet.move_velocity = direction * bullet_speed
	bullet.set_target(target)
	bullet.rotation = direction.angle()

func _fire_wood_bullet(target: Node2D):
	var bullet = wood_bullet_scene.instantiate()
	get_parent().add_child(bullet)
	bullet.global_position = global_position
	bullet.speed = bullet_speed - 100
	bullet.damage = bullet_damage * 1.5
	bullet.bounce_count = wood_bounce_count
	bullet.knockback_force = 200.0
	var direction = (target.global_position - global_position).normalized()
	bullet.move_velocity = direction * bullet_speed
	bullet.rotation = direction.angle()

func _shoot_water():
	if water_bullet_scene == null:
		return
	var enemies = get_tree().get_nodes_in_group(\"enemies\")
	if enemies.is_empty():
		return
	var target_enemy = enemies[randi() % enemies.size()]
	var bullet = water_bullet_scene.instantiate()
	get_parent().add_child(bullet)
	bullet.global_position = target_enemy.global_position
	bullet.move_velocity = Vector2.ZERO

func take_damage(amount: float):
	current_hp -= amount
	current_hp = clamp(current_hp, 0, max_hp)
	shake_screen(10.0)
	queue_redraw()
	if current_hp <= 0:
		_die()

func _die():
	get_tree().reload_current_scene()

# Skill sistemi
func upgrade_speed(amount: float):
	speed += amount

func upgrade_fire_rate(amount: float):
	fire_rate = max(0.05, fire_rate - amount)

func upgrade_damage(amount: float):
	bullet_damage += amount

func upgrade_max_hp(amount: float):
	max_hp += amount
	current_hp += amount
	queue_redraw()

func upgrade_double_shot(_value: float):
	double_shot = true

func upgrade_bullet_speed(amount: float):
	bullet_speed += amount

func upgrade_air_bullet(_value: float):
	if not air_unlocked:
		air_unlocked = true
	else:
		air_bounce_count += 1

func upgrade_water_bullet(_value: float):
	if not water_unlocked:
		water_unlocked = true
	else:
		water_interval = max(1.0, water_interval - 1.0)

func upgrade_wood_bullet(_value: float):
	if not wood_unlocked:
		wood_unlocked = true
	else:
		wood_bounce_count += 1

func _play_animation(input: Vector2):
	if input.x > 0 and input.y < 0:
		anim.play(\"up_right\")
	elif input.x < 0 and input.y < 0:
		anim.play(\"up_left\")
	elif input.x > 0 and input.y > 0:
		anim.play(\"down_right\")
	elif input.x < 0 and input.y > 0:
		anim.play(\"down_left\")
	elif input.y < 0:
		anim.play(\"up\")
	elif input.y > 0:
		anim.play(\"down\")
	elif input.x < 0:
		anim.play(\"left\")
	else:
		anim.play(\"right\")
"

