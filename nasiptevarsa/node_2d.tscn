[sub_resource type="GDScript" id="GDScript_5m0gc"]
script/source = "extends Node2D

@export var spawn_radius: float = 300.0

@export var enemy_configs: Array = [
	{
		\"scene\": \"res://Enemy/Bat/Enemy.tscn\",
		\"interval\": 2.0,
		\"enabled\": true
	},
	{
		\"scene\": \"res://Enemy/RareBat/Enemy.tscn\",
		\"interval\": 4.0,
		\"enabled\": true
	},
	{
		\"scene\": \"res://Enemy/RareRareBat/Enemy.tscn\",
		\"interval\": 20.0,
		\"enabled\": true
	},
]

var timers: Array = []
var player: Node2D = null

func _ready():
	player = get_tree().get_first_node_in_group(\"player\")
	for config in enemy_configs:
		timers.append(config[\"interval\"])

func _process(delta):
	if player == null:
		return
	for i in range(enemy_configs.size()):
		var config = enemy_configs[i]
		if not config[\"enabled\"]:
			continue
		timers[i] -= delta
		if timers[i] <= 0:
			timers[i] = config[\"interval\"]
			_spawn_enemy(config[\"scene\"])

func _spawn_enemy(scene_path: String):
	var packed = load(scene_path)
	if packed == null:
		print(\"HATA: sahne yüklenemedi:\", scene_path)
		return
	var angle = randf() * TAU
	var offset = Vector2(cos(angle), sin(angle)) * spawn_radius
	var enemy = packed.instantiate()
	add_child(enemy)
	enemy.global_position = player.global_position + offset

	# Wave'e göre güçlendir
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm:
		var mult = gm.get_wave_multiplier()
		enemy.hp *= mult
		enemy.speed = min(enemy.speed * mult, 200)
		enemy.damage *= mult
"

[sub_resource type="GDScript" id="GDScript_m3qd1"]
script/source = "extends Node

signal level_up(new_level)
signal kill_added(total_kills)
signal game_over

var xp: float = 0.0
var xp_to_next: float = 10.0
var level: int = 1
var kills: int = 0

# Wave sistemi
var wave: int = 1
var wave_timer: float = 0.0
var wave_interval: float = 20.0

func _ready():
	add_to_group(\"game_manager\")
	level_up.connect(_on_level_up)

func _process(delta):
	wave_timer += delta
	if wave_timer >= wave_interval:
		wave_timer = 0.0
		wave += 1
		_strengthen_enemies()
		print(\"Wave:\", wave)

func _strengthen_enemies():
	var enemies = get_tree().get_nodes_in_group(\"enemies\")
	for e in enemies:
		e.hp *= 1.2
		e.speed = min(e.speed + 10, 200)
		e.damage *= 1.1

func add_xp(amount: float):
	xp += amount
	if xp >= xp_to_next:
		xp -= xp_to_next
		xp_to_next = xp_to_next * 1.5
		level += 1
		level_up.emit(level)

func _on_level_up(_new_level):
	var menu = get_tree().get_first_node_in_group(\"skill_menu\")
	if menu:
		menu.show_menu()

func get_wave_multiplier() -> float:
	return 1.0 + (wave - 1) * 0.2

func add_kill():
	kills += 1
	kill_added.emit(kills)

func trigger_game_over():
	game_over.emit()
"

[sub_resource type="GDScript" id="GDScript_hud"]
script/source = "extends CanvasLayer

var elapsed: float = 0.0
@onready var timer_label: Label = $TimerLabel
@onready var level_label: Label = $LevelLabel
@onready var kill_label: Label = $KillLabel
@onready var xp_bar: ProgressBar = $XPBar

func _ready():
	add_to_group(\"hud\")
	_refresh_level()
	_refresh_kills()
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm and gm.has_signal(\"level_up\"):
		gm.level_up.connect(_on_level_up)
	if gm and gm.has_signal(\"kill_added\"):
		gm.kill_added.connect(_on_kill_added)

func _process(delta):
	elapsed += delta
	var total_seconds: int = int(elapsed)
	var minutes: int = total_seconds / 60
	var seconds: int = total_seconds - (minutes * 60)
	timer_label.text = \"%02d:%02d\" % [minutes, seconds]
	# Her frame XP barı güncelle
	_refresh_xp()

func _on_level_up(new_level):
	level_label.text = \"LVL %d\" % new_level

func _on_kill_added(total_kills):
	kill_label.text = \"KILLS %d\" % total_kills

func _refresh_level():
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm:
		level_label.text = \"LVL %d\" % gm.level
	else:
		level_label.text = \"LVL 1\"

func _refresh_kills():
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm:
		kill_label.text = \"KILLS %d\" % gm.kills
	else:
		kill_label.text = \"KILLS 0\"

func _refresh_xp():
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm == null:
		return
	xp_bar.max_value = gm.xp_to_next
	xp_bar.value = gm.xp
"

