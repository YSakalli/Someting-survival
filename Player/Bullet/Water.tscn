[sub_resource type="GDScript" id="GDScript_8akx7"]
script/source = "extends Area2D

var move_velocity = Vector2.ZERO
var damage = 5.0
var freeze_duration = 2

@onready var anim = $AnimatedSprite2D

func _ready():
	body_entered.connect(_on_body_entered)
	anim.sprite_frames.set_animation_loop(\"default\", false)
	anim.z_index = 10
	anim.visible = false  # başta gizli

func _physics_process(delta):
	position += move_velocity * delta

func _on_body_entered(body):
	if not body.is_in_group(\"enemies\"):
		return
	body.take_damage(damage)
	body.freeze(freeze_duration)
	move_velocity = Vector2.ZERO
	$CollisionShape2D.set_deferred(\"disabled\", true)
	anim.visible = true   # çarpınca göster
	anim.play(\"default\")
	var frame_count = anim.sprite_frames.get_frame_count(\"default\")
	var fps = anim.sprite_frames.get_animation_speed(\"default\")
	var duration = frame_count / fps
	await get_tree().create_timer(duration).timeout
	queue_free()

func _on_visible_on_screen_notifier_2d_screen_exited():
	queue_free()
"

