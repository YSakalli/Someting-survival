[sub_resource type="GDScript" id="GDScript_4kf6v"]
script/source = "extends CanvasLayer

var player: Node2D = null
var pixel_font: SystemFont = null

var all_skills = [
	{\"name\": \"HAREKET HIZI\", \"action\": \"upgrade_speed\",       \"value\": 30.0, \"icon\": \"res://src/hareket hızı.png\"},
	{\"name\": \"SALDIRI HIZI\", \"action\": \"upgrade_fire_rate\",   \"value\": 0.1,  \"icon\": \"res://src/saldırı hızı2.png\"},
	{\"name\": \"SALDIRI GÜCÜ\", \"action\": \"upgrade_damage\",      \"value\": 10.0, \"icon\": \"res://src/saldırı gücü.png\"},
	{\"name\": \"CAN ARTIŞI\",   \"action\": \"upgrade_max_hp\",      \"value\": 50.0, \"icon\": \"res://src/can artışı.png\"},
	{\"name\": \"ÇİFT SALDIRI\", \"action\": \"upgrade_double_shot\", \"value\": 1.0,  \"icon\": \"res://src/çift saldırı.png\"},
	{\"name\": \"AIR\",          \"action\": \"upgrade_air_bullet\",  \"value\": 1.0,  \"emoji\": \"💨\"},
	{\"name\": \"WATER\",        \"action\": \"upgrade_water_bullet\",\"value\": 1.0,  \"emoji\": \"💧\"},
	{\"name\": \"WOOD\",         \"action\": \"upgrade_wood_bullet\", \"value\": 1.0,  \"emoji\": \"🪵\"},
]

func _ready():
	add_to_group(\"skill_menu\")
	visible = false
	pixel_font = SystemFont.new()
	pixel_font.font_names = PackedStringArray([\"Consolas\", \"Courier New\", \"monospace\"])
	pixel_font.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	pixel_font.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	pixel_font.hinting = TextServer.HINTING_NONE
	player = get_tree().get_first_node_in_group(\"player\")

func show_menu():
	get_tree().paused = true
	visible = true
	player = get_tree().get_first_node_in_group(\"player\")
	_create_cards()

func _create_cards():
	var hbox = $Frame/HBoxContainer
	for child in hbox.get_children():
		child.queue_free()
	var shuffled = all_skills.duplicate()
	shuffled.shuffle()
	var choices = shuffled.slice(0, 3)
	for skill in choices:
		hbox.add_child(_build_card(skill))

func _build_card(skill: Dictionary) -> Control:
	var btn = Button.new()
	btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	btn.size_flags_vertical = Control.SIZE_EXPAND_FILL
	btn.flat = true
	btn.focus_mode = Control.FOCUS_NONE
	btn.pressed.connect(_on_skill_selected.bind(skill))
	btn.flat = false
	var sb_normal = StyleBoxFlat.new()
	sb_normal.bg_color = Color(0, 0, 0, 0)
	sb_normal.border_color = Color(0, 0, 0, 0)
	sb_normal.corner_radius_top_left = 10
	sb_normal.corner_radius_top_right = 10
	sb_normal.corner_radius_bottom_left = 10
	sb_normal.corner_radius_bottom_right = 10
	var sb_hover = StyleBoxFlat.new()
	sb_hover.bg_color = Color(1, 1, 1, 0.08)
	sb_hover.border_width_left = 2
	sb_hover.border_width_right = 2
	sb_hover.border_width_top = 2
	sb_hover.border_width_bottom = 2
	sb_hover.border_color = Color(1, 1, 1, 0.9)
	sb_hover.corner_radius_top_left = 10
	sb_hover.corner_radius_top_right = 10
	sb_hover.corner_radius_bottom_left = 10
	sb_hover.corner_radius_bottom_right = 10
	sb_hover.shadow_size = 28
	sb_hover.shadow_color = Color(1, 0.95, 0.6, 0.65)
	btn.add_theme_stylebox_override(\"normal\", sb_normal)
	btn.add_theme_stylebox_override(\"hover\", sb_hover)
	btn.add_theme_stylebox_override(\"pressed\", sb_hover)
	btn.add_theme_stylebox_override(\"focus\", sb_normal)
	btn.add_theme_stylebox_override(\"disabled\", sb_normal)
	btn.resized.connect(func(): btn.pivot_offset = btn.size / 2)
	btn.mouse_entered.connect(func():
		btn.pivot_offset = btn.size / 2
		var tw = create_tween()
		tw.set_parallel(true)
		tw.tween_property(btn, \"scale\", Vector2(1.06, 1.06), 0.12)
	)
	btn.mouse_exited.connect(func():
		var tw = create_tween()
		tw.tween_property(btn, \"scale\", Vector2(1, 1), 0.12)
	)
	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_theme_constant_override(\"separation\", 50)
	btn.add_child(vbox)
	if skill.has(\"icon\"):
		var tex = load(skill[\"icon\"])
		if tex:
			var icon = TextureRect.new()
			icon.texture = tex
			icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			icon.custom_minimum_size = Vector2(140, 140)
			icon.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
			vbox.add_child(icon)
	var name_label = Label.new()
	name_label.text = skill[\"name\"]
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.add_theme_font_override(\"font\", pixel_font)
	name_label.add_theme_font_size_override(\"font_size\", 28)
	name_label.add_theme_color_override(\"font_color\", Color(1, 1, 1))
	name_label.add_theme_color_override(\"font_outline_color\", Color(0, 0, 0))
	name_label.add_theme_constant_override(\"outline_size\", 6)
	vbox.add_child(name_label)
	return btn

func _on_skill_selected(skill: Dictionary):
	if player == null:
		return
	player.call(skill[\"action\"], skill[\"value\"])
	if player.has_method(\"flash_level_up\"):
		player.flash_level_up()
	get_tree().paused = false
	visible = false
"

[sub_resource type="GDScript" id="GDScript_gameover"]
script/source = "extends CanvasLayer

@onready var label: Label = $GameOverLabel
@onready var hint: Label = $HintLabel
@onready var background: ColorRect = $Background

func _ready():
	visible = false
	process_mode = Node.PROCESS_MODE_ALWAYS
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm and gm.has_signal(\"game_over\"):
		gm.game_over.connect(_on_game_over)

func _on_game_over():
	visible = true
	get_tree().paused = true

func _unhandled_input(event):
	if not visible:
		return
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_R or event.keycode == KEY_SPACE or event.keycode == KEY_ENTER:
			get_tree().paused = false
			get_tree().reload_current_scene()
"

