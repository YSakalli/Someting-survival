[sub_resource type="GDScript" id="GDScript_5m0gc"]
script/source = "extends Node2D

@export var enemy_scene: PackedScene
@export var spawn_interval: float = 2.0
@export var spawn_radius: float = 300.0

var spawn_timer: float = 0.0
var player: Node2D = null

func _ready():
	player = get_tree().get_first_node_in_group(\"player\")

func _process(delta):
	if player == null:
		return
	
	spawn_timer -= delta
	if spawn_timer <= 0:
		spawn_timer = spawn_interval
		_spawn_enemy()

func _spawn_enemy():
	if enemy_scene == null:
		print(\"HATA: enemy_scene atanmamış!\")
		return
	
	# Rastgele açı seç
	var angle = randf() * TAU
	var offset = Vector2(cos(angle), sin(angle)) * spawn_radius
	
	var enemy = enemy_scene.instantiate()
	add_child(enemy)
	enemy.global_position = player.global_position + offset
	print(\"Düşman doğdu:\", enemy.global_position)
"

[sub_resource type="GDScript" id="GDScript_m3qd1"]
script/source = "extends Node

signal level_up(new_level)

var xp: float = 0.0
var xp_to_next: float = 10.0
var level: int = 1

func _ready():
	add_to_group(\"game_manager\")
	level_up.connect(_on_level_up)

func add_xp(amount: float):
	xp += amount
	if xp >= xp_to_next:
		xp -= xp_to_next
		xp_to_next = xp_to_next * 1.5
		level += 1
		level_up.emit(level)

func _on_level_up(_new_level):
	var menu = get_tree().get_first_node_in_group(\"skill_menu\")
	if menu:
		menu.show_menu()
	else:
		print(\"HATA: skill_menu bulunamadı!\")
"

[sub_resource type="GDScript" id="GDScript_4kf6v"]
script/source = "extends CanvasLayer

var player: Node2D = null
var pixel_font: SystemFont = null

var all_skills = [
	{\"name\": \"HIZ\",        \"action\": \"upgrade_speed\",        \"value\": 30.0,  \"icon\": \"res://src/hareket hızı.png\"},
	{\"name\": \"ATES HIZI\",  \"action\": \"upgrade_fire_rate\",    \"value\": 0.1,   \"icon\": \"res://src/saldırı hızı2.png\"},
	{\"name\": \"HASAR\",      \"action\": \"upgrade_damage\",       \"value\": 10.0,  \"icon\": \"res://src/saldırı gücü.png\"},
	{\"name\": \"CAN\",        \"action\": \"upgrade_max_hp\",       \"value\": 50.0,  \"icon\": \"res://src/can artışı.png\"},
	{\"name\": \"CIFT MERMI\", \"action\": \"upgrade_double_shot\",  \"value\": 1.0,   \"icon\": \"res://src/çift saldırı.png\"},
	{\"name\": \"MERMI HIZI\", \"action\": \"upgrade_bullet_speed\", \"value\": 100.0, \"icon\": \"res://src/hareket hızı.png\"},
	{\"name\": \"AIR\",        \"action\": \"upgrade_air_bullet\",   \"value\": 1.0,   \"icon\": \"res://src/Air/Retro Impact Effect Pack 3 F.png\"},
	{\"name\": \"WATER\",      \"action\": \"upgrade_water_bullet\", \"value\": 1.0,   \"icon\": \"res://src/Water/Retro Impact Effect Pack 3 C.png\"},
	{\"name\": \"WOOD\",       \"action\": \"upgrade_wood_bullet\",  \"value\": 1.0,   \"icon\": \"res://src/saldırı gücü.png\"},
]

func _ready():
	add_to_group(\"skill_menu\")
	visible = false
	pixel_font = SystemFont.new()
	pixel_font.font_names = PackedStringArray([\"Consolas\", \"Courier New\", \"monospace\"])
	pixel_font.antialiasing = 0
	pixel_font.subpixel_positioning = 0
	pixel_font.hinting = 0
	player = get_tree().get_first_node_in_group(\"player\")

func show_menu():
	get_tree().paused = true
	visible = true
	player = get_tree().get_first_node_in_group(\"player\")
	_create_cards()

func _create_cards():
	var hbox = $Frame/HBoxContainer
	for child in hbox.get_children():
		child.queue_free()
	var shuffled = all_skills.duplicate()
	shuffled.shuffle()
	var choices = shuffled.slice(0, 3)
	for skill in choices:
		hbox.add_child(_build_card(skill))

func _build_card(skill: Dictionary) -> Control:
	var btn = Button.new()
	btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	btn.size_flags_vertical = Control.SIZE_EXPAND_FILL
	btn.flat = true
	btn.focus_mode = Control.FOCUS_NONE
	btn.pressed.connect(_on_skill_selected.bind(skill))

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_theme_constant_override(\"separation\", 16)
	btn.add_child(vbox)

	if skill.has(\"icon\"):
		var tex = load(skill[\"icon\"])
		if tex:
			var icon = TextureRect.new()
			icon.texture = tex
			icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			icon.custom_minimum_size = Vector2(140, 140)
			icon.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
			vbox.add_child(icon)

	var name_label = Label.new()
	name_label.text = skill[\"name\"]
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.add_theme_font_override(\"font\", pixel_font)
	name_label.add_theme_font_size_override(\"font_size\", 28)
	name_label.add_theme_color_override(\"font_color\", Color(1, 1, 1))
	name_label.add_theme_color_override(\"font_outline_color\", Color(0, 0, 0))
	name_label.add_theme_constant_override(\"outline_size\", 6)
	vbox.add_child(name_label)

	return btn

func _on_skill_selected(skill: Dictionary):
	if player == null:
		return
	player.call(skill[\"action\"], skill[\"value\"])
	if player.has_method(\"flash_level_up\"):
		player.flash_level_up()
	get_tree().paused = false
	visible = false
"

