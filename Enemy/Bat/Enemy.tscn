[sub_resource type="GDScript" id="GDScript_tt7e2"]
resource_name = "Enemy"
script/source = "extends CharacterBody2D

@export var gem_scene: PackedScene
@onready var anim = $AnimatedSprite2D

var hp = 20.0
var speed = 80.0
var base_speed = 80.0
var damage = 5.0
var frozen = false
var knockback_velocity = Vector2.ZERO
var player: Node2D = null

func _ready():
	add_to_group(\"enemies\")
	player = get_tree().get_first_node_in_group(\"player\")
	anim.play(\"default\")

func _physics_process(delta):
	if player == null:
		return
	if frozen:
		return
	if knockback_velocity.length() > 10:
		velocity = knockback_velocity
		knockback_velocity = knockback_velocity.lerp(Vector2.ZERO, 0.2)
	else:
		knockback_velocity = Vector2.ZERO
		var dir = (player.global_position - global_position).normalized()
		velocity = dir * speed
	move_and_slide()

	# Player'a yakınsa hasar ver ama itme, kendini geri çek
	if global_position.distance_to(player.global_position) < 20:
		player.take_damage(damage * delta)
		var push_back = (global_position - player.global_position).normalized()
		global_position += push_back * speed * delta

func take_damage(amount: float):
	hp -= amount
	if hp <= 0:
		call_deferred(\"_drop_gem\")
		queue_free()

func _drop_gem():
	if gem_scene == null:
		return
	var gem = gem_scene.instantiate()
	get_parent().call_deferred(\"add_child\", gem)
	gem.global_position = global_position

func apply_knockback(force: Vector2):
	knockback_velocity = force

func freeze(duration: float):
	frozen = true
	modulate = Color(0.3, 0.5, 1.0)
	await get_tree().create_timer(duration).timeout
	if is_instance_valid(self):
		frozen = false
		modulate = Color.WHITE
"

