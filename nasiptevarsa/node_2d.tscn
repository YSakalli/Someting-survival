[sub_resource type="GDScript" id="GDScript_hud"]
script/source = "extends CanvasLayer

var elapsed: float = 0.0

@onready var timer_label: Label = $TimerLabel
@onready var level_label: Label = $LevelLabel

func _ready():
	add_to_group(\"hud\")
	_refresh_level()
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm and gm.has_signal(\"level_up\"):
		gm.level_up.connect(_on_level_up)

func _process(delta):
	elapsed += delta
	var total_seconds = int(elapsed)
	var minutes = total_seconds / 60
	var seconds = total_seconds % 60
	timer_label.text = \"%02d:%02d\" % [minutes, seconds]

func _on_level_up(new_level):
	level_label.text = \"LVL %d\" % new_level

func _refresh_level():
	var gm = get_tree().get_first_node_in_group(\"game_manager\")
	if gm:
		level_label.text = \"LVL %d\" % gm.level
	else:
		level_label.text = \"LVL 1\"
"

