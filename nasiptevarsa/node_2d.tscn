[sub_resource type="GDScript" id="GDScript_5m0gc"]
script/source = "extends Node2D

@export var enemy_scene: PackedScene
@export var spawn_interval: float = 2.0
@export var spawn_radius: float = 300.0

var spawn_timer: float = 0.0
var player: Node2D = null

func _ready():
	player = get_tree().get_first_node_in_group(\"player\")

func _process(delta):
	if player == null:
		return
	
	spawn_timer -= delta
	if spawn_timer <= 0:
		spawn_timer = spawn_interval
		_spawn_enemy()

func _spawn_enemy():
	if enemy_scene == null:
		print(\"HATA: enemy_scene atanmamış!\")
		return
	
	# Rastgele açı seç
	var angle = randf() * TAU
	var offset = Vector2(cos(angle), sin(angle)) * spawn_radius
	
	var enemy = enemy_scene.instantiate()
	add_child(enemy)
	enemy.global_position = player.global_position + offset
	print(\"Düşman doğdu:\", enemy.global_position)
"

[sub_resource type="GDScript" id="GDScript_m3qd1"]
script/source = "extends Node

signal level_up(new_level)

var xp: float = 0.0
var xp_to_next: float = 10.0
var level: int = 1

func _ready():
	add_to_group(\"game_manager\")
	level_up.connect(_on_level_up)

func add_xp(amount: float):
	xp += amount
	if xp >= xp_to_next:
		xp -= xp_to_next
		xp_to_next = xp_to_next * 1.5
		level += 1
		level_up.emit(level)

func _on_level_up(_new_level):
	var menu = get_tree().get_first_node_in_group(\"skill_menu\")
	if menu:
		menu.show_menu()
	else:
		print(\"HATA: skill_menu bulunamadı!\")
"

[sub_resource type="GDScript" id="GDScript_4kf6v"]
script/source = "extends CanvasLayer

var player: Node2D = null

var all_skills = [
	{\"name\": \"Hız Artışı\",  \"desc\": \"Hareket hızın +30\",        \"action\": \"upgrade_speed\",        \"value\": 30.0},
	{\"name\": \"Ateş Hızı\",   \"desc\": \"Daha sık ateş edersin\",    \"action\": \"upgrade_fire_rate\",    \"value\": 0.1},
	{\"name\": \"Hasar\",       \"desc\": \"Mermi hasarın +10\",         \"action\": \"upgrade_damage\",       \"value\": 10.0},
	{\"name\": \"Can Artışı\",  \"desc\": \"Max canın +50\",             \"action\": \"upgrade_max_hp\",       \"value\": 50.0},
	{\"name\": \"Çift Mermi\",  \"desc\": \"İki yönde ateş edersin\",   \"action\": \"upgrade_double_shot\",  \"value\": 1.0},
	{\"name\": \"Mermi Hızı\",  \"desc\": \"Mermi hızın +100\",         \"action\": \"upgrade_bullet_speed\", \"value\": 100.0},
	{\"name\": \"Air\",         \"desc\": \"Takip eden, seken mermi\",  \"action\": \"upgrade_air_bullet\",   \"value\": 1.0},
	{\"name\": \"Water\",       \"desc\": \"Düşmanı donduran su\",      \"action\": \"upgrade_water_bullet\", \"value\": 1.0},
	{\"name\": \"Wood\",        \"desc\": \"Geri iten, seken mermi\",   \"action\": \"upgrade_wood_bullet\",  \"value\": 1.0},
]

func _ready():
	add_to_group(\"skill_menu\")
	visible = false
	player = get_tree().get_first_node_in_group(\"player\")

func show_menu():
	get_tree().paused = true
	visible = true
	player = get_tree().get_first_node_in_group(\"player\")
	_create_cards()

func _create_cards():
	var hbox = $Panel/VBoxContainer/HBoxContainer
	for child in hbox.get_children():
		child.queue_free()
	var shuffled = all_skills.duplicate()
	shuffled.shuffle()
	var choices = shuffled.slice(0, 3)
	for skill in choices:
		var btn = Button.new()
		btn.custom_minimum_size = Vector2(180, 200)
		btn.text = skill[\"name\"] + \"\\n\\n\" + skill[\"desc\"]
		btn.pressed.connect(_on_skill_selected.bind(skill))
		hbox.add_child(btn)

func _on_skill_selected(skill: Dictionary):
	if player == null:
		return
	player.call(skill[\"action\"], skill[\"value\"])
	if player.has_method(\"sway_screen\"):
		player.sway_screen(18.0)
	get_tree().paused = false
	visible = false
"

