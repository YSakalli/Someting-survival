[gd_scene format=3 uid="uid://b5xpgemc7d2k8"]

[sub_resource type="GDScript" id="GDScript_xpgem"]
resource_name = "XPGem"
script/source = "extends Area2D

@export var xp_value: float = 2.0
@export var magnet_range: float = 80.0
@export var magnet_speed: float = 280.0

var player: Node2D = null
var collected: bool = false
var time_alive: float = 0.0

func _ready():
	add_to_group(\"xp_gems\")
	body_entered.connect(_on_body_entered)
	player = get_tree().get_first_node_in_group(\"player\")

func _process(delta):
	time_alive += delta
	queue_redraw()
	if collected:
		return
	if player == null or not is_instance_valid(player):
		player = get_tree().get_first_node_in_group(\"player\")
		return
	var dist = global_position.distance_to(player.global_position)
	if dist <= magnet_range:
		var dir = (player.global_position - global_position).normalized()
		var pull = 1.0 - dist / magnet_range
		global_position += dir * magnet_speed * (0.3 + pull) * delta

func _on_body_entered(body):
	if collected:
		return
	if body.is_in_group(\"player\"):
		collected = true
		var gm = get_tree().get_first_node_in_group(\"game_manager\")
		if gm:
			gm.add_xp(xp_value)
		queue_free()

func _draw():
	var pulse = 1.0 + sin(time_alive * 5.0) * 0.18
	draw_circle(Vector2.ZERO, 5.0 * pulse, Color(0.2, 0.5, 0.9, 0.35))
	draw_circle(Vector2.ZERO, 3.2 * pulse, Color(0.4, 0.85, 1.0, 1.0))
	draw_circle(Vector2.ZERO, 1.3 * pulse, Color(0.95, 1.0, 1.0, 1.0))
"

[sub_resource type="CircleShape2D" id="CircleShape2D_xpgem"]
radius = 5.0

