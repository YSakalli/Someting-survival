[gd_scene format=3 uid="uid://dip7aqituo5cx"]

[ext_resource type="Texture2D" uid="uid://b2pjmiom2fdj4" path="res://src/Water/Retro Impact Effect Pack 3 C.png" id="1_3us8d"]

[sub_resource type="GDScript" id="GDScript_8akx7"]
script/source = "extends Area2D

var move_velocity = Vector2.ZERO
var damage = 15.0
var speed = 300.0
var bounce_count = 1
var bounces_done = 0
var knockback_force = 200.0
var hit_enemies = []

func _ready():
	body_entered.connect(_on_body_entered)

func _physics_process(delta):
	position += move_velocity * delta

func _on_body_entered(body):
	if not body.is_in_group(\"enemies\"):
		return
	if body in hit_enemies:
		return
	hit_enemies.append(body)
	body.take_damage(damage)
	var knockback_dir = (body.global_position - global_position).normalized()
	body.apply_knockback(knockback_dir * knockback_force)
	bounces_done += 1
	if bounces_done >= bounce_count:
		queue_free()
		return
	_bounce_to_next()

func _bounce_to_next():
	var enemies = get_tree().get_nodes_in_group(\"enemies\")
	var nearest = null
	var min_dist = INF
	for e in enemies:
		if e in hit_enemies:
			continue
		var d = global_position.distance_to(e.global_position)
		if d < min_dist:
			min_dist = d
			nearest = e
	if nearest:
		var dir = (nearest.global_position - global_position).normalized()
		move_velocity = dir * speed
		rotation = dir.angle()
	else:
		queue_free()

func _draw():
	draw_rect(Rect2(-6, -4, 12, 8), Color(0.5, 0.3, 0.1))

func _on_visible_on_screen_notifier_2d_screen_exited():
	queue_free()
"

